# Copiar las variables reales en Vercel. Nunca subir valores secretos al repositorio.
DATABASE_URL=
PUBLIC_BASE_URL=https://sorathemes.com

# Mercado Pago Checkout Pro (Tus integraciones > tu aplicación > Credenciales).
# Access Token: solo en el servidor. Las credenciales de prueba empiezan con TEST-.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks > Clave secreta).
MP_WEBHOOK_SECRET=
# Moneda de cobro: USD (precios del catálogo) o ARS (convierte con MP_ARS_PER_USD).
MP_CURRENCY=USD
# Solo con MP_CURRENCY=ARS: pesos por dólar, por ejemplo 1400.
MP_ARS_PER_USD=

DRIVE_FOLDERS={}
